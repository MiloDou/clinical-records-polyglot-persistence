# MySQL (Centro Médico Pediátrico - Brayan)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=tu_contraseña_local
MYSQL_DB=pediatria_db

# Firebase Firestore (ruta relativa a backend/, o ruta absoluta)
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# PostgreSQL (Hospital General - Ronaldo)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=clinica_poliglota

# MongoDB (Laboratorio Clínico - Ronaldo)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=laboratorio_db

# JWT Core
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
